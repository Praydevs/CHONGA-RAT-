set "RUN="
if not defined RUN (where pythonw.exe >nul 2>&1 && set "RUN=pythonw.exe")
if not defined RUN (where python.exe >nul 2>&1 && set "RUN=python.exe")
if not defined RUN (where py.exe >nul 2>&1 && set "RUN=py.exe -3")
if not defined RUN exit /b 4
start "" /min %RUN% "%SCRIPT%"
exit /b 0
